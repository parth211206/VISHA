# ============================================================
# India Snakebite Clinical Decision-Support System
# Environment Configuration Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ---- Application ----
APP_ENV=development
APP_SECRET_KEY=CHANGE_ME_to_a_long_random_string_at_least_32_chars
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Database (PostgreSQL + PostGIS) ----
DATABASE_URL=postgresql+asyncpg://snakebite:snakebite_dev_password@localhost:5432/snakebite_dev
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ---- Dataset paths (absolute, read-only raw data) ----
RAW_DATASET_ROOT=C:\AI_ML_Project\Snake Images
RAW_OCCURRENCE_CSV=C:\AI_ML_Project\occurrence.csv
RAW_SNAKECLEF_METADATA_CSV=C:\AI_ML_Project\SnakeCLEF2021_min-train_metadata_PROD.csv
RAW_SPECIES_COUNTRY_MAPPING_CSV=C:\AI_ML_Project\species_to_country_mapping.csv

# ---- Derived data paths ----
DERIVED_DATA_ROOT=C:\AI_ML_Project\data
MANIFESTS_DIR=C:\AI_ML_Project\data\manifests
TAXONOMY_FILE=C:\AI_ML_Project\data\taxonomy\india_snakes_taxonomy_v1.yaml
CLINICAL_KNOWLEDGE_FILE=C:\AI_ML_Project\data\clinical\clinical_knowledge_v1.yaml
ANTIVENOM_REFERENCE_FILE=C:\AI_ML_Project\data\antivenom\antivenom_reference_v1.yaml

# ---- ML model ----
ML_MODEL_DIR=C:\AI_ML_Project\ml\artifacts
ML_BINARY_MODEL_PATH=C:\AI_ML_Project\ml\artifacts\binary_classifier_latest.pt
ML_DEVICE=cpu
ML_BATCH_SIZE=32

# ---- Authentication (JWT) ----
JWT_SECRET_KEY=CHANGE_ME_another_long_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Clinical safety ----
# Minimum confidence to display a prediction (below this = show as UNCERTAIN)
MIN_CONFIDENCE_THRESHOLD=0.60
# OOD score threshold (above this = flag as out-of-distribution)
OOD_SCORE_THRESHOLD=0.80

# ---- Surveillance ----
# Whether to record de-identified surveillance records automatically on case confirmation
SURVEILLANCE_AUTO_RECORD=true
# Coordinate precision for de-identification (decimal places, 2 = ~1km grid)
SURVEILLANCE_COORD_PRECISION=2
